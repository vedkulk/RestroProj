    }
  },
  "/api/booking/v1/*": {
    "target": "http://localhost:8080",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/booking/v1": "/bookings"
    }
  },
  "/userses": {
    "target": "http://localhost:8080",
